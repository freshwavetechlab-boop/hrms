ALTER TABLE workflow_action_rules
ADD COLUMN IF NOT EXISTS ResourceIdSource VARCHAR(120) NOT NULL DEFAULT 'route.id' AFTER ResourceType;

ALTER TABLE workflow_action_rules
ADD COLUMN IF NOT EXISTS ClientIdSource VARCHAR(120) NOT NULL DEFAULT '' AFTER ResourceIdRouteKey;

ALTER TABLE workflow_action_rules
ADD COLUMN IF NOT EXISTS ClientLookupTable VARCHAR(120) NOT NULL DEFAULT '' AFTER ClientIdSql;

ALTER TABLE workflow_action_rules
ADD COLUMN IF NOT EXISTS ClientLookupKeyColumn VARCHAR(120) NOT NULL DEFAULT '' AFTER ClientLookupTable;

ALTER TABLE workflow_action_rules
ADD COLUMN IF NOT EXISTS ClientLookupClientColumn VARCHAR(120) NOT NULL DEFAULT '' AFTER ClientLookupKeyColumn;

UPDATE workflow_action_rules
SET ResourceIdSource = CONCAT('route.', ResourceIdRouteKey)
WHERE (ResourceIdSource IS NULL OR ResourceIdSource = '') AND ResourceIdRouteKey <> '';

UPDATE workflow_action_rules
SET ResourceIdSource = 'route.id', ClientIdSource = '', ClientIdSql = '', ClientLookupTable = 'payruns', ClientLookupKeyColumn = 'Id', ClientLookupClientColumn = 'ClientId'
WHERE ActivityCode = 'PAYRUN.SUBMIT' AND HttpMethod = 'POST' AND PathPattern = '/api/pay-runs/{id}/submit';
