ALTER TABLE salarycomponents
    ADD COLUMN ComponentRole VARCHAR(80) NOT NULL DEFAULT 'Regular Earning' AFTER ComponentType,
    ADD COLUMN StatutoryType VARCHAR(80) NOT NULL DEFAULT 'None' AFTER ComponentRole;

UPDATE salarycomponents
SET ComponentRole = CASE
    WHEN Category = 'Deduction' THEN 'Regular Deduction'
    WHEN Category = 'Reimbursement' THEN 'Reimbursement'
    WHEN Category = 'Benefit' THEN 'Employer Contribution'
    WHEN Category = 'Correction' THEN 'Arrear / Correction'
    ELSE 'Regular Earning'
END
WHERE ComponentRole = '' OR ComponentRole IS NULL OR (ComponentRole = 'Regular Earning' AND Category <> 'Earning');

UPDATE salarycomponents
SET ComponentRole = 'Statutory Deduction',
    StatutoryType = CASE
        WHEN Code IN ('PF', 'EPF', 'EPF_EMP') THEN 'PF Employee'
        WHEN Code IN ('VPF') THEN 'VPF'
        WHEN Code IN ('ESIC', 'ESI') THEN 'ESI Employee'
        WHEN Code IN ('PT', 'PT_LWF_WC') THEN 'Professional Tax'
        WHEN Code IN ('TDS') THEN 'TDS'
        ELSE StatutoryType
    END
WHERE Category = 'Deduction'
  AND Code IN ('PF', 'EPF', 'EPF_EMP', 'VPF', 'ESIC', 'ESI', 'PT', 'PT_LWF_WC', 'TDS');

UPDATE salarycomponents
SET ComponentRole = 'Recovery',
    StatutoryType = 'None'
WHERE Category = 'Deduction'
  AND Code IN ('RECOVERY', 'LOAN', 'ADVANCE');

