UPDATE recruitment_open_positions
SET ApprovedPositions = NumberOfPositions
WHERE ApprovedPositions = 1 AND NumberOfPositions <> 1;

UPDATE recruitment_open_positions
SET RemainingPositions = GREATEST(0, ApprovedPositions - FilledPositions - CancelledPositions - OnHoldPositions)
WHERE RemainingPositions = 1 OR RemainingPositions IS NULL;

