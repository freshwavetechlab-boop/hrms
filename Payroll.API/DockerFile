FROM mcr.microsoft.com/dotnet/sdk:8.0 AS build
WORKDIR /src

# Copies the contents of hrms/Payroll.API into /src
COPY . .

# Look for the project file directly in the current directory
RUN dotnet restore "Payroll.API.csproj"
RUN dotnet publish "Payroll.API.csproj" -c Release -o /app/publish

FROM mcr.microsoft.com/dotnet/aspnet:8.0
WORKDIR /app
RUN apt-get update \
    && apt-get install -y --no-install-recommends antiword poppler-utils tesseract-ocr tesseract-ocr-eng \
    && rm -rf /var/lib/apt/lists/*
COPY --from=build /app/publish .
RUN mkdir -p /app/App_Data/attachments

ENV ASPNETCORE_URLS=http://+:8080
EXPOSE 8080
ENTRYPOINT ["dotnet", "Payroll.API.dll"]
